# 恒致创造嵌入式软件格式配置（QRS-0002-2026 §5.2）
# 使用方式: clang-format -i <file>

BasedOnStyle: LLVM

# 缩进：4 个空格，禁止 Tab
IndentWidth: 4
TabWidth: 4
UseTab: Never

# 禁止返回类型主动换行（但 ColumnLimit 可能会覆盖）
AlwaysBreakAfterReturnType: None

#大幅提高“返回类型单独一行”的惩罚值
PenaltyReturnTypeOnItsOwnLine: 10000

# 行宽上限
ColumnLimit: 120

# 花括号风格
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true          # 函数定义后花括号换行（独占一行）
  AfterControlStatement: Never # if/for/while/switch 花括号不换行
  AfterStruct: false           # 结构体定义后不换行
  AfterEnum: false             # 枚举定义后不换行
  AfterClass: false            # 类定义后不换行
  BeforeElse: false            # else 与前面 } 同行
  BeforeCatch: false           # catch 与前面 } 同行
  AfterCaseLabel: false        # case 标签的换行不额外处理

# designated 初始化：.field = { 保持同行，避免嵌套结构体异常换行与过度缩进
BreakBeforeBinaryOperators: All
Cpp11BracedListStyle: true

AlignArrayOfStructures: Left               # 结构体数组初始化按列左对齐
AlignConsecutiveAssignments: Consecutive   # 变量赋值等号对齐
AlignConsecutiveDeclarations: Consecutive  # 变量声明类型对齐
AlignConsecutiveMacros: AcrossComments  # 宏定义数值对齐（跨注释块，如 #define 间的 /** */）
AlignEscapedNewlines: Right              # 宏续行 \ 对齐到 ColumnLimit 列

# 控制语句花括号不得省略
InsertBraces: true

# 指针/引用对齐（靠近类型名）
PointerAlignment: Right

# 函数参数超长时的折叠方式
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false

# 注释对齐
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
SpacesBeforeTrailingComments: 10 # 设置最小间距

# include 排序
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup

# 空行控制
MaxEmptyLinesToKeep: 1
EmptyLineAfterAccessModifier: Never

# 短语句不合并到一行
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty      # 空 {} 与控制语句合并为一行
